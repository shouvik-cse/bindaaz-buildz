// Cloudflare Workers config: publishes the built site in dist/ and runs worker.js
// for the /img photo service and the /render AI picture. Cloudflare reads this when it runs `npx wrangler deploy`.
{
  "name": "bindaaz-buildz",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // Workers AI (free daily allowance), used by /render for the realistic picture of the finished PC
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
